{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "daily_cost_chart",
  "position": {
    "x": 20,
    "y": 145,
    "z": 6,
    "height": 555,
    "width": 760,
    "tabOrder": 6
  },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "date"
                }
              },
              "queryRef": "dim_date.date",
              "nativeQueryRef": "date",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_project"
                    }
                  },
                  "Property": "project"
                }
              },
              "queryRef": "dim_project.project",
              "nativeQueryRef": "project"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_daily_cost"
                    }
                  },
                  "Property": "Cost (AUD)"
                }
              },
              "queryRef": "fact_daily_cost.Cost (AUD)",
              "nativeQueryRef": "Cost (AUD)"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Daily cost by project (AUD)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}