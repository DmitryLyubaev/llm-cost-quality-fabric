table fact_eval_attempt
	sourceLineageTag: [gold].[fact_eval_attempt]

	/// Mirrors lakehouse.answers.quality_across_models
	measure 'Results (n)' =
			CALCULATE(
			    COUNTROWS(fact_eval_attempt),
			    KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored")
			)
		formatString: #,##0
		displayFolder: Quality

	/// Mirrors lakehouse.answers.quality_across_models
	measure 'Success rate' =
			CALCULATE(
			    AVERAGEX(
			        fact_eval_attempt,
			        IF(NOT ISBLANK(fact_eval_attempt[success]), IF(fact_eval_attempt[success], 1, 0))
			    ),
			    KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored")
			)
		formatString: 0.0%
		displayFolder: Quality

	/// Mirrors lakehouse.answers.quality_across_models
	measure 'Latency (ms)' =
			CALCULATE(
			    AVERAGE(fact_eval_attempt[latency_ms]),
			    KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored")
			)
		formatString: #,##0.0
		displayFolder: Quality

	/// Mirrors lakehouse.answers.quality_across_models
	measure 'Groundedness (mean)' =
			CALCULATE(
			    AVERAGE(fact_eval_attempt[groundedness]),
			    KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored")
			)
		formatString: 0.000
		displayFolder: Quality

	/// Mirrors lakehouse.answers.quality_across_models
	measure 'Citation recall' =
			CALCULATE(
			    AVERAGE(fact_eval_attempt[citation_recall]),
			    KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored")
			)
		formatString: 0.000
		displayFolder: Quality

	/// Mirrors lakehouse.answers.quality_across_models
	measure 'Citation precision' =
			CALCULATE(
			    AVERAGE(fact_eval_attempt[citation_precision]),
			    KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored")
			)
		formatString: 0.000
		displayFolder: Quality

	/// Mirrors lakehouse.answers.quality_across_models
	measure 'Must-contain rate' =
			CALCULATE(
			    AVERAGEX(
			        fact_eval_attempt,
			        IF(NOT ISBLANK(fact_eval_attempt[must_contain]), IF(fact_eval_attempt[must_contain], 1, 0))
			    ),
			    KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored")
			)
		formatString: 0.0%
		displayFolder: Quality

	/// Mirrors lakehouse.answers.quality_across_models
	measure 'Top-1 rate' =
			CALCULATE(
			    AVERAGEX(
			        fact_eval_attempt,
			        IF(NOT ISBLANK(fact_eval_attempt[top1]), IF(fact_eval_attempt[top1], 1, 0))
			    ),
			    KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored")
			)
		formatString: 0.0%
		displayFolder: Quality

	/// Mirrors lakehouse.answers.quality_across_models
	measure MRR =
			CALCULATE(
			    AVERAGE(fact_eval_attempt[reciprocal_rank]),
			    KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored")
			)
		formatString: 0.000
		displayFolder: Quality

	/// Mirrors lakehouse.answers.quality_across_models
	measure 'Tool-call accuracy' =
			CALCULATE(
			    AVERAGE(fact_eval_attempt[tool_call_accuracy]),
			    KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored")
			)
		formatString: 0.000
		displayFolder: Quality

	/// Mirrors lakehouse.answers.quality_across_models
	measure 'Task adherence' =
			CALCULATE(
			    AVERAGE(fact_eval_attempt[task_adherence]),
			    KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored")
			)
		formatString: 0.000
		displayFolder: Quality

	/// Mirrors lakehouse.answers.quality_across_models
	measure 'Intent resolution' =
			CALCULATE(
			    AVERAGE(fact_eval_attempt[intent_resolution]),
			    KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored")
			)
		formatString: 0.000
		displayFolder: Quality

	/// Mirrors lakehouse.answers.cost_per_result
	measure 'Estimated cost per result (USD)' =
			VAR results = [Results (n)]
			VAR unpriced =
			    CALCULATE(
			        COUNTROWS(fact_eval_attempt),
			        KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored"),
			        KEEPFILTERS(ISBLANK(fact_eval_attempt[cost_usd])),
			        KEEPFILTERS(NOT ISBLANK(fact_eval_attempt[cost_basis]) && fact_eval_attempt[cost_basis] <> "no_model")
			    )
			VAR estimated =
			    CALCULATE(
			        SUM(fact_eval_attempt[cost_usd]),
			        KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored")
			    )
			RETURN
			    IF(ISBLANK(unpriced), DIVIDE(estimated, results))
		formatString: #,##0.000000
		displayFolder: Quality

	/// Mirrors lakehouse.answers.cost_per_result
	measure 'Estimated cost per result (AUD)' =
			VAR perResultUsd = [Estimated cost per result (USD)]
			VAR projects =
			    CALCULATETABLE(
			        VALUES(fact_eval_attempt[project]),
			        KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored")
			    )
			VAR fxMonth =
			    FORMAT(
			        CALCULATE(
			            MIN(fact_eval_attempt[started_at]),
			            KEEPFILTERS(fact_eval_attempt[attempt_kind] = "scored")
			        ),
			        "yyyy-MM"
			    )
			VAR billedInAud =
			    NOT ISEMPTY(
			        CALCULATETABLE(
			            fact_daily_cost,
			            REMOVEFILTERS(fact_daily_cost),
			            TREATAS(projects, fact_daily_cost[project]),
			            fact_daily_cost[billing_currency] = "AUD"
			        )
			    )
			VAR rateLines =
			    CALCULATETABLE(
			        fact_daily_cost,
			        REMOVEFILTERS(fact_daily_cost),
			        fact_daily_cost[billing_month] = fxMonth,
			        fact_daily_cost[billing_currency] = "AUD",
			        fact_daily_cost[pricing_currency] = "USD",
			        NOT ISBLANK(fact_daily_cost[fx_pricing_to_billing])
			    )
			VAR lowRate = MINX(rateLines, fact_daily_cost[fx_pricing_to_billing])
			VAR highRate = MAXX(rateLines, fact_daily_cost[fx_pricing_to_billing])
			VAR usdToAud = IF(NOT ISBLANK(lowRate) && lowRate = highRate, lowRate)
			RETURN
			    IF(billedInAud && NOT ISBLANK(usdToAud) && NOT ISBLANK(perResultUsd), perResultUsd * usdToAud)
		formatString: #,##0.000000
		displayFolder: Quality

	column study
