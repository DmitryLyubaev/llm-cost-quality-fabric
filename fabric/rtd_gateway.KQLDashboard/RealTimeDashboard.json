  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "6c37d6bb-6d6f-48e1-a132-88cb509b456f"
      },
      "text": "// Calls the gateway itself refused (throttling), by status, per minute. Refused calls have no answered_by.\nGatewayCalls()\n| where refused_by_gateway == true\n| summarize refusals = count() by minute = bin(event_time, 1m), status\n| order by minute asc\n",
      "id": "952eb301-6293-4864-9806-bac6109d23d6",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "6c37d6bb-6d6f-48e1-a132-88cb509b456f"
      },
      "text": "// Calls by the backend that answered, per minute. Calls with no backend (refused or failed) are left out.\nGatewayCalls()\n| where isnotempty(answered_by)\n| summarize calls = count() by minute = bin(event_time, 1m), answered_by\n| order by minute asc\n",
      "id": "b3355483-a8ea-4d4f-a15f-4e9f1d130cfe",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "6c37d6bb-6d6f-48e1-a132-88cb509b456f"
      },
      "text": "// Tokens consumed per caller per minute. Calls with no token count are left out.\nGatewayCalls()\n| where isnotnull(tokens)\n| summarize tokens = sum(tokens) by minute = bin(event_time, 1m), caller\n| order by minute asc, caller asc\n",
      "id": "92a22189-b910-40db-a36c-47c06b2c73f1",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "6c37d6bb-6d6f-48e1-a132-88cb509b456f"
      },
      "text": "// End-to-end delay to first availability: the earliest ingestion time of the request minus event time, in seconds.\nGatewayCalls()\n| extend delay_s = (first_ingested - event_time) / 1s\n| summarize p50 = percentile(delay_s, 50), p95 = percentile(delay_s, 95), max_s = max(delay_s), n = count()\n",
      "id": "9de24d62-5bc6-4e10-94be-835177e68c5e",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "6c37d6bb-6d6f-48e1-a132-88cb509b456f"
      },
      "text": "// Requests by session and caller. GatewayCalls() is one row per request_id, so count() is exact.\nGatewayCalls()\n| summarize calls = count() by session, caller\n| order by session asc, caller asc\n",
      "id": "059e93dc-b153-4d80-9c09-e0010605989d",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "6c37d6bb-6d6f-48e1-a132-88cb509b456f"
      },
      "text": "// Minutes in which at least one call was answered by the secondary backend.\nGatewayCalls()\n| where answered_by == \"secondary\"\n| summarize secondary_calls = count() by minute = bin(event_time, 1m)\n| order by minute asc\n| where minute >= _startTime and minute < bin(_endTime, 1m)\n",
      "id": "e265b4b0-5a35-449e-84aa-986872f5b3ea",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "6c37d6bb-6d6f-48e1-a132-88cb509b456f"
      },
      "text": "let threshold = 5000;\n// Caller-minutes whose summed tokens exceed the threshold (the Activator rule's condition).\nGatewayCalls()\n| where isnotnull(tokens)\n| summarize tokens = sum(tokens) by minute = bin(event_time, 1m), caller\n| where tokens > threshold\n| order by minute asc, caller asc\n| where minute >= _startTime and minute < bin(_endTime, 1m)\n",
      "id": "9f30d17f-2cac-44a8-8ea6-e703c315a10f",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    }
  ],
  "embeddedApps": []
}
