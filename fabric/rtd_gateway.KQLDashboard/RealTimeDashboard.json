      "databaseArtifactId": "70675b27-fc20-40ec-8234-e5a6bc7ad1cf",
      "database": "70675b27-fc20-40ec-8234-e5a6bc7ad1cf",
      "workspace": "00000000-0000-0000-0000-000000000000",
      "id": "6c37d6bb-6d6f-48e1-a132-88cb509b456f"
