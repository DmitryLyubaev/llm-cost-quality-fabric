  {
    "uniqueIdentifier": "000828dc-c080-4189-9618-ea430ba30247",
    "payload": {
      "name": "failover_minutes tile",
      "runSettings": {
        "executionIntervalInSeconds": 300
      },
      "query": {
        "queryString": "let _startTime = ago(1h);\nlet _endTime = now();\n// Minutes in which at least one call was answered by the secondary backend.\ndatabase(\"kql_gateway\").GatewayCalls()\n| where answered_by == \"secondary\"\n| summarize secondary_calls = count() by minute = bin(event_time, 1m)\n| order by minute asc\n| where minute >= _startTime and minute < bin(_endTime, 1m)\n"
      },
      "eventhouseItem": {
        "targetUniqueIdentifier": "84a9c8b1-b26d-47ce-9b29-4cf9e1244570"
      },
      "parentContainer": {
        "targetUniqueIdentifier": "3ef637cb-b4e2-417a-b1d1-0b0b348f3da0"
      }
    },
    "type": "kqlSource-v1"
  },
