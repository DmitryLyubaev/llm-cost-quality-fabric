  {
    "uniqueIdentifier": "4260b1f6-0244-4c59-b1c3-10ef821b0c41",
    "payload": {
      "name": "token_spike_minutes tile",
      "runSettings": {
        "executionIntervalInSeconds": 300
      },
      "query": {
        "queryString": "let _startTime = ago(1h);\nlet _endTime = now();\nlet threshold = 5000;\n// Caller-minutes whose summed tokens exceed the threshold (the Activator rule's condition).\ndatabase(\"kql_gateway\").GatewayCalls()\n| where isnotnull(tokens)\n| summarize tokens = sum(tokens) by minute = bin(event_time, 1m), caller\n| where tokens > threshold\n| order by minute asc, caller asc\n| where minute >= _startTime and minute < bin(_endTime, 1m)\n"
      },
      "eventhouseItem": {
        "targetUniqueIdentifier": "84a9c8b1-b26d-47ce-9b29-4cf9e1244570"
      },
      "parentContainer": {
        "targetUniqueIdentifier": "3ef637cb-b4e2-417a-b1d1-0b0b348f3da0"
      }
    },
    "type": "kqlSource-v1"
  },
